import HC4.Polynomial.RankThreeCubicDetOneSourceTransverseRepairOriginWitness
import Mathlib.Tactic

/-!
# What weight-five trace-zero really forces in the rank-three leading-Hessian chart

Suppose A is a symmetric singular matrix over a field and its kernel
is the line generated by a fixed nonzero vector v. If a principal
cofactor at an index k with v[k] != 0 is nonzero, the adjugate of A
is a nonzero scalar multiple of v ⊗ v.

Thus tr(adj(A)*C)=0 implies the *quadratic* isotropy constraint

   sum_i sum_j v[i]*C[i,j]*v[j] = 0.

It does NOT imply C*v=0: C*v can be nonzero and isotropic.
The latter is the actual possibility needed to repair a cubic
pole. The theorem below makes the rank-three/one-dimensional
kernel hypothesis completely explicit; it is NOT silently
inferred from transverse rank two.

No source endpoint or characteristic assumption is required.
-/

namespace HC4.Polynomial.RankThreeCubic

open scoped Matrix BigOperators
noncomputable section

variable {K : Type*} [Field K]

/-- A nonzero rank-three symmetric adjugate, with a
one-dimensional kernel, makes a trace-zero first correction
isotropic along the kernel generator. -/
theorem symmetric_kernelLine_adjugateTrace_zero_implies_isotropic
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A C : Matrix ι ι K)
    (hSym : A.IsSymm)
    (v : ι → K)
    (hker : A *ᵥ v = 0)
    (hline : ∀ z : ι → K, A *ᵥ z = 0 →
      ∃ c : K, ∀ i : ι, z i = c * v i)
    (k : ι)
    (hkk : A.adjugate k k ≠ 0)
    (htrace : (A.adjugate * C).trace = 0) :
    (∑ i : ι, ∑ j : ι, v i * C i j * v j) = 0 := by
  classical
  by_cases hv : v = 0
  · subst v
    simp
  have hadjSym : A.adjugate.IsSymm := by
    change A.adjugate.transpose = A.adjugate
    rw [Matrix.adjugate_transpose, hSym]
  have hdet : A.det = 0 :=
    Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hv, hker⟩
  have hAadj : A * A.adjugate = 0 := by
    rw [Matrix.mul_adjugate, hdet]
    simp
  have hcolker (j : ι) :
      A *ᵥ (fun i => A.adjugate i j) = 0 := by
    funext i
    have hij := congrArg (fun B : Matrix ι ι K => B i j) hAadj
    simpa only [Matrix.mulVec, dotProduct, Matrix.mul_apply,
      Matrix.zero_apply] using hij
  choose c hc using (fun j : ι => hline (fun i => A.adjugate i j) (hcolker j))
  have hlink (j : ι) : c j * v k = c k * v j := by
    calc
      c j * v k = A.adjugate k j := (hc j k).symm
      _ = A.adjugate j k := hadjSym.apply k j
      _ = c k * v j := hc k j
  have hck : c k ≠ 0 := by
    intro hz
    apply hkk
    rw [hc k k, hz, zero_mul]
  have htraceExpand :
      (A.adjugate * C).trace =
        ∑ j : ι, ∑ i : ι, A.adjugate i j * C j i := by
    change (∑ i : ι, ∑ j : ι, A.adjugate i j * C j i) =
      ∑ j : ι, ∑ i : ι, A.adjugate i j * C j i
    exact Finset.sum_comm
  have hweighted :
      v k * (∑ j : ι, ∑ i : ι, A.adjugate i j * C j i) =
        c k * (∑ j : ι, ∑ i : ι, v j * C j i * v i) := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro i _
    rw [hc j i]
    calc
      v k * (c j * v i * C j i) =
          (c j * v k) * (v i * C j i) := by ring
      _ = (c k * v j) * (v i * C j i) := by rw [hlink j]
      _ = c k * (v j * C j i * v i) := by ring
  have hvan :
      c k * (∑ j : ι, ∑ i : ι, v j * C j i * v i) = 0 := by
    rw [← hweighted, ← htraceExpand, htrace, mul_zero]
  have hzero :
      (∑ j : ι, ∑ i : ι, v j * C j i * v i) = 0 :=
    (mul_eq_zero.mp hvan).resolve_left hck
  exact hzero

end
end HC4.Polynomial.RankThreeCubic
