import HC4.Polynomial.RankThreeCubicDetOneLeadingFullHessianSingular
import Mathlib.LinearAlgebra.Matrix.Nondegenerate
import Mathlib.Tactic

/-!
# A surviving principal cofactor determines the singular kernel line

For any square matrix A over an integral domain, a nonzero
principal adjugate entry at k gives an injective linear map
after replacing row k by the kth coordinate selector.

Therefore a vector killed by A and zero at k must vanish.
If v is a kernel vector whose kth coordinate is a unit, every
other kernel vector z is a scalar multiple of v: subtract
(z[k] / v[k])*v and use that injective row replacement.

Unlike a rank-oracle argument over a fraction field, this
works directly over the actual prime quotient domain.
Symmetry is not required.
-/

namespace HC4.Polynomial.RankThreeCubic

open scoped Matrix BigOperators
noncomputable section

/-- A nonzero kth diagonal cofactor makes the kth coordinate
injective when restricted to the kernel. No field inverse
or rank theorem is needed. -/
theorem principalCofactor_kernel_zero_of_coordinate_zero
    {R ι : Type*} [CommRing R] [IsDomain R]
    [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι R) (k : ι)
    (hkk : A.adjugate k k ≠ 0)
    (z : ι → R)
    (hz : A *ᵥ z = 0) (hzk : z k = 0) :
    z = 0 := by
  classical
  let B := A.updateRow k (Pi.single k (1 : R))
  have hB : B.det ≠ 0 := by
    simpa only [Matrix.adjugate_apply] using hkk
  apply Matrix.eq_zero_of_mulVec_eq_zero hB
  funext i
  by_cases hik : i = k
  · subst i
    simpa [B, Matrix.mulVec, dotProduct, Matrix.updateRow_apply,
      Pi.single_apply, hzk] using hzk
  · have hi := congrFun hz i
    simpa [B, Matrix.mulVec, dotProduct, Matrix.updateRow_apply,
      hik] using hi

/-- If a fixed nonzero vector spans a singular direction, a
surviving principal cofactor cannot be located at a zero
coordinate of that direction. -/
theorem principalCofactor_kernel_coordinate_ne_zero
    {R ι : Type*} [CommRing R] [IsDomain R]
    [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι R) (v : ι → R) (k : ι)
    (hkk : A.adjugate k k ≠ 0)
    (hv : A *ᵥ v = 0)
    (hvn : v ≠ 0) :
    v k ≠ 0 := by
  intro hvk
  exact hvn (principalCofactor_kernel_zero_of_coordinate_zero
    A k hkk v hv hvk)

/-- The singular kernel is the line generated by a vector
with a unit coordinate at a surviving principal cofactor.
This source-neutral theorem holds over a domain, not just
over its fraction field. -/
theorem principalCofactor_kernelLine_of_unitCoordinate
    {R ι : Type*} [CommRing R] [IsDomain R]
    [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι R) (v : ι → R) (k : ι)
    (hkk : A.adjugate k k ≠ 0)
    (hv : A *ᵥ v = 0)
    (hvk : IsUnit (v k)) :
    ∀ z : ι → R, A *ᵥ z = 0 →
      ∃ c : R, ∀ i : ι, z i = c * v i := by
  classical
  let u : Rˣ := hvk.unit
  have hu : (u : R) = v k := hvk.unit_spec
  intro z hz
  let c : R := z k * (↑u⁻¹ : R)
  let d : ι → R := z - c • v
  have hdk : d k = 0 := by
    change z k - c * v k = 0
    dsimp [c]
    rw [← hu]
    simp [mul_assoc]
  have hd : A *ᵥ d = 0 := by
    change A *ᵥ (z - c • v) = 0
    rw [Matrix.mulVec_sub, Matrix.mulVec_smul, hz, hv]
    simp
  have hd0 : d = 0 :=
    principalCofactor_kernel_zero_of_coordinate_zero
      A k hkk d hd hdk
  refine ⟨c, ?_⟩
  intro i
  have hi := congrFun hd0 i
  have hzi : z i - c * v i = 0 := by
    simpa [d, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] using hi
  exact sub_eq_zero.mp hzi

end
end HC4.Polynomial.RankThreeCubic
