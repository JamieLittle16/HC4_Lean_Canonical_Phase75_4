import HC4.Polynomial.RankThreeCubicDetOnePrincipalCofactorKernelLine
import Mathlib.LinearAlgebra.Matrix.Symmetric
import Mathlib.Tactic

/-!
# Vanishing full adjugate in the fixed-transverse-kernel rank-two chart

Let A be a symmetric four-by-four matrix over an integral domain.
Suppose A kills (0,w), with unit transverse coordinate w[k], and
the transverse three-by-three block H has a surviving principal
cofactor at k. If the FULL A has zero kth transverse principal
cofactor, then adj(A)=0.

This is a rank-two statement over the actual coefficient domain;
no fraction-field rank oracle or adapted Hessian completion is used.

Every adjugate column is killed by A. The nonzero fixed kernel
vector has longitudinal coordinate zero, forcing the longitudinal
adjugate row to vanish. Each remaining transverse adjugate column
therefore belongs to ker H, which is the line generated by w.
The zero full principal cofactor kills the kth column, and
symmetry eliminates all remaining columns.
-/

namespace HC4.Polynomial.RankThreeCubic

open scoped Matrix BigOperators
noncomputable section

set_option maxHeartbeats 3000000

/-- A NONZERO kernel vector whose ith coordinate vanishes forces
the entire ith row of adj(A) to vanish. The nonzero condition is
essential: the zero vector alone gives no such implication. -/
theorem adjugate_entry_zero_of_nonzero_kernel_coordinate_zero
    {R ι : Type*} [CommRing R] [IsDomain R]
    [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι R)
    (z : ι → R) (hz : A *ᵥ z = 0) (hzn : z ≠ 0)
    (i j : ι) (hzi : z i = 0) :
    A.adjugate i j = 0 := by
  classical
  by_contra hij
  let B := A.updateRow j (Pi.single i (1 : R))
  have hB : B.det ≠ 0 := by
    simpa only [Matrix.adjugate_apply] using hij
  have hBz : B *ᵥ z = 0 := by
    funext t
    by_cases ht : t = j
    · subst t
      simpa [B, Matrix.mulVec, dotProduct, Matrix.updateRow_apply,
        Pi.single_apply, hzi] using hzi
    · have htt := congrFun hz t
      simpa [B, Matrix.mulVec, dotProduct, Matrix.updateRow_apply,
        ht] using htt
  exact hzn (Matrix.eq_zero_of_mulVec_eq_zero hB hBz)

/-- A genuine transverse rank-two principal pivot and a fixed
transverse kernel force the FULL adjugate to vanish as soon as
its corresponding transverse principal cofactor vanishes.

It is enough to assume a single zero FULL principal cofactor
at the surviving transverse pivot. -/
theorem symmetricFour_fullAdjugate_zero_of_transverseKernel_pivot
    {R : Type*} [CommRing R] [IsDomain R]
    (A : Matrix (Unit ⊕ Fin 3) (Unit ⊕ Fin 3) R)
    (hSym : A.IsSymm)
    (w : Fin 3 → R) (k : Fin 3)
    (hwk : IsUnit (w k))
    (hAw : A *ᵥ (Sum.elim (fun _ : Unit => (0 : R)) w) = 0)
    (hHkk :
      (A.submatrix Sum.inr Sum.inr).adjugate k k ≠ 0)
    (hAkk : A.adjugate (.inr k) (.inr k) = 0) :
    A.adjugate = 0 := by
  classical
  let H : Matrix (Fin 3) (Fin 3) R :=
    A.submatrix Sum.inr Sum.inr
  let B : Matrix (Unit ⊕ Fin 3) (Unit ⊕ Fin 3) R :=
    A.adjugate
  let v : Unit ⊕ Fin 3 → R :=
    Sum.elim (fun _ : Unit => 0) w
  have hwkn : w k ≠ 0 := hwk.ne_zero
  have hvn : v ≠ 0 := by
    intro hz
    apply hwkn
    have hk := congrFun hz (.inr k)
    simpa [v] using hk
  have hdet : A.det = 0 :=
    Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hvn, hAw⟩
  have hAB : A * B = 0 := by
    change A * A.adjugate = 0
    rw [Matrix.mul_adjugate, hdet]
    simp
  have hBsym : B.IsSymm := by
    change A.adjugate.transpose = A.adjugate
    rw [Matrix.adjugate_transpose, hSym]
  have hLongRow (j : Unit ⊕ Fin 3) :
      B (.inl ()) j = 0 :=
    adjugate_entry_zero_of_nonzero_kernel_coordinate_zero
      A v hAw hvn (.inl ()) j (by rfl)
  have hLongCol (i : Unit ⊕ Fin 3) :
      B i (.inl ()) = 0 :=
    (hBsym.apply (.inl ()) i).trans (hLongRow i)
  have hHker : H *ᵥ w = 0 := by
    funext i
    have hi := congrFun hAw (.inr i)
    simpa [H, v, Matrix.mulVec, dotProduct,
      Fintype.sum_sum_type] using hi
  have hHline :
      ∀ z : Fin 3 → R, H *ᵥ z = 0 →
        ∃ c : R, ∀ i : Fin 3, z i = c * w i :=
    principalCofactor_kernelLine_of_unitCoordinate
      H w k hHkk hHker hwk
  have hColKernel (j : Fin 3) :
      H *ᵥ (fun i : Fin 3 => B (.inr i) (.inr j)) = 0 := by
    funext i
    have hij := congrArg
      (fun C : Matrix (Unit ⊕ Fin 3) (Unit ⊕ Fin 3) R =>
        C (.inr i) (.inr j)) hAB
    have hlong : B (.inl ()) (.inr j) = 0 :=
      hLongRow (.inr j)
    simpa [H, Matrix.mulVec, dotProduct,
      Matrix.mul_apply, Fintype.sum_sum_type, hlong] using hij
  obtain ⟨c, hc⟩ :=
    hHline (fun i => B (.inr i) (.inr k)) (hColKernel k)
  have hc0 : c = 0 := by
    have hk := hc k
    change A.adjugate (.inr k) (.inr k) = c * w k at hk
    rw [hAkk] at hk
    exact (mul_eq_zero.mp hk.symm).resolve_right hwkn
  have hColumnK (i : Fin 3) :
      B (.inr i) (.inr k) = 0 := by
    simpa [hc0] using hc i
  have hRowK (j : Fin 3) :
      B (.inr k) (.inr j) = 0 :=
    (hBsym.apply (.inr j) (.inr k)).trans (hColumnK j)
  have hTrans (i j : Fin 3) :
      B (.inr i) (.inr j) = 0 := by
    obtain ⟨d, hd⟩ :=
      hHline (fun m => B (.inr m) (.inr j)) (hColKernel j)
    have hd0 : d = 0 := by
      have hj := hd k
      rw [hRowK j] at hj
      exact (mul_eq_zero.mp hj.symm).resolve_right hwkn
    simpa [hd0] using hd i
  change B = 0
  ext i j
  cases i with
  | inl u => exact hLongRow j
  | inr i =>
    cases j with
    | inl u => exact hLongCol (.inr i)
    | inr j => exact hTrans i j

end
end HC4.Polynomial.RankThreeCubic
