import HC4.Polynomial.RationalCharacteristicRankOneFieldEmbedding

/-!
# Recover the original common parameter from a simple image field

The embedding of the velocity field into RatFunc has already
been verified. If its image intermediate field is generated by
one element, lift that element back to the original field.
Every original velocity is then a rational function of this
lifted parameter, and the verified source endpoint applies.

The only external mathematical obligation of this bridge is
simple generation of intermediate fields of RatFunc (Lüroth).
That obligation is an explicit hypothesis, not an axiom.
-/

namespace HC4.Polynomial.RankThreeCubic

open MvPolynomial
open scoped Matrix BigOperators

noncomputable section

variable {K : Type*} [Field K]

private abbrev B (K : Type*) [Field K] := MvPolynomial (Fin 3) K
private abbrev E (K : Type*) [Field K] := FractionRing (B K)
private abbrev I := Unit ⊕ Fin 3
private abbrev S (K : Type*) [Field K] := MvPolynomial I K
private abbrev P (K : Type*) [Field K] := _root_.Polynomial K

/-- Lift rational representations from a simple image field
through an injective algebra homomorphism. The denominator
can always be chosen nonzero, including for the zero element. -/
theorem rationalField_commonParameter_of_simpleImage
    (F : IntermediateField K (E K))
    (ψ : F →ₐ[K] RatFunc K)
    (h : ∃ u : RatFunc K, ψ.fieldRange = IntermediateField.adjoin K {u})
    (v : Fin 3 → F) :
    ∃ (t : E K) (A Q : Fin 3 → P K),
      (∀ i, (Q i).eval₂ (algebraMap K (E K)) t ≠ 0) ∧
      ∀ i, (v i : E K) = (A i).eval₂ (algebraMap K (E K)) t /
        (Q i).eval₂ (algebraMap K (E K)) t := by
  classical
  obtain ⟨u, hu⟩ := h
  have hum : u ∈ ψ.fieldRange := by
    rw [hu]
    exact IntermediateField.mem_adjoin_simple_self K u
  obtain ⟨t, ht⟩ := AlgHom.mem_fieldRange.mp hum
  have hrep (i : Fin 3) : ∃ A Q : P K,
      _root_.Polynomial.aeval t Q ≠ 0 ∧
      v i = _root_.Polynomial.aeval t A / _root_.Polynomial.aeval t Q := by
    by_cases hv : v i = 0
    · refine ⟨0, 1, by simp, ?_⟩
      simp [hv]
    · have hm : ψ (v i) ∈ IntermediateField.adjoin K {u} := by
        rw [← hu]
        exact AlgHom.mem_fieldRange.mpr ⟨v i, rfl⟩
      obtain ⟨A, Q, he⟩ :=
        (IntermediateField.mem_adjoin_simple_iff K (ψ (v i))).mp hm
      have hq : _root_.Polynomial.aeval u Q ≠ 0 := by
        intro hz
        rw [hz, div_zero] at he
        apply hv
        apply ψ.toRingHom.injective
        simpa only [map_zero] using he
      have hmap (p : P K) :
          ψ (_root_.Polynomial.aeval t p) = _root_.Polynomial.aeval u p := by
        rw [← ht, _root_.Polynomial.aeval_algHom]
        rfl
      refine ⟨A, Q, ?_, ?_⟩
      · intro hz
        apply hq
        rw [← hmap, hz, map_zero]
      · apply ψ.toRingHom.injective
        rw [map_div₀, hmap, hmap]
        exact he
  choose A Q hQ hV using hrep
  refine ⟨(t : E K), A, Q, ?_, ?_⟩
  · intro i
    have he : F.val (_root_.Polynomial.aeval t (Q i)) =
        (Q i).eval₂ (algebraMap K (E K)) (t : E K) := by
      rw [← _root_.Polynomial.aeval_def, _root_.Polynomial.aeval_algHom]
      rfl
    rw [← he]
    simpa only [map_zero] using F.val.toRingHom.injective.ne (hQ i)
  · intro i
    have he := congrArg F.val (hV i)
    have hmap (p : P K) :
        F.val (_root_.Polynomial.aeval t p) =
          p.eval₂ (algebraMap K (E K)) (t : E K) := by
      rw [← _root_.Polynomial.aeval_def, _root_.Polynomial.aeval_algHom]
      rfl
    change F.val (v i) = F.val (_root_.Polynomial.aeval t (A i) /
      _root_.Polynomial.aeval t (Q i)) at he
    rw [map_div₀, hmap, hmap] at he
    exact he

variable [CharZero K]

/-- Rank one yields the common rational parameter as soon as the
univariate intermediate-field simple-generation theorem is available. -/
theorem rankOne_commonParameter_of_univariateSimpleGeneration
    (hLuroth : ∀ G : IntermediateField K (RatFunc K),
      ∃ u : RatFunc K, G = IntermediateField.adjoin K {u})
    (V : I → E K)
    (hn : rationalCharacteristicJacobian V ≠ 0)
    (hm : ∀ a b i j : Fin 3,
      rationalCharacteristicJacobian V a b * rationalCharacteristicJacobian V i j =
        rationalCharacteristicJacobian V a j * rationalCharacteristicJacobian V i b) :
    ∃ (t : E K) (A Q : Fin 3 → P K),
      (∀ i, (Q i).eval₂ (algebraMap K (E K)) t ≠ 0) ∧
      ∀ i, V (.inr i) = (A i).eval₂ (algebraMap K (E K)) t /
        (Q i).eval₂ (algebraMap K (E K)) t := by
  let F := IntermediateField.adjoin K (Set.range (fun a : Fin 3 => V (.inr a)))
  let v (i : Fin 3) : F :=
    ⟨V (.inr i), IntermediateField.subset_adjoin ⟨i, rfl⟩⟩
  obtain ⟨ψ, _⟩ := rankOne_velocityField_exists_embedding V hn hm
  exact rationalField_commonParameter_of_simpleImage F ψ
    (hLuroth ψ.fieldRange) v

/-- The source adjugate endpoint for every characteristic Jacobian
of rank at most one, conditional solely on ordinary univariate
Lüroth. The rank-zero case uses the existing unconditional theorem. -/
theorem rationalCharacteristic_rankAtMostOne_adjugate_of_univariateSimpleGeneration
    (hLuroth : ∀ G : IntermediateField K (RatFunc K),
      ∃ u : RatFunc K, G = IntermediateField.adjoin K {u})
    (a : K) (L : S K) (V : I → E K)
    (hdet : (hessian L).det = 0)
    (hV : V (.inl ()) = 1)
    (hreg : MvPolynomial.aeval (transverseGenericPoint a)
      ((hessian L).submatrix Sum.inr Sum.inr).det ≠ 0)
    (hgrad : ∀ i, lineEval (transverseGenericPoint a) V (pderiv i L) =
      _root_.Polynomial.C (MvPolynomial.aeval (transverseGenericPoint a) (pderiv i L)))
    (hm : ∀ a b i j : Fin 3,
      rationalCharacteristicJacobian V a b * rationalCharacteristicJacobian V i j =
        rationalCharacteristicJacobian V a j * rationalCharacteristicJacobian V i b) :
    ∃ d : I → K, d ≠ 0 ∧
      (hessian L).adjugate *ᵥ (fun i => MvPolynomial.C (d i)) = 0 := by
  by_cases hz : rationalCharacteristicJacobian V = 0
  · exact rationalCharacteristic_rankZero_adjugate_annihilator a L V hdet hV hreg hgrad hz
  · obtain ⟨t, A, Q, hQ, hv⟩ :=
      rankOne_commonParameter_of_univariateSimpleGeneration hLuroth V hz hm
    exact rationalCharacteristic_commonParameter_adjugate_annihilator a L V
      hdet hV hreg hgrad t A Q hQ hv

end
end HC4.Polynomial.RankThreeCubic
