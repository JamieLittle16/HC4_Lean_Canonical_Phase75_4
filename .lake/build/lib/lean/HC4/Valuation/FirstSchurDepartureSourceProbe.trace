  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: ===== HC4/Valuation/FirstSchurDepartureBridge.lean =====",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 1: import HC4.Valuation.ActualParameterLayer",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 2: import HC4.Valuation.CanonicalSmithReesSpecialFiber",
   "level": "info"},
  {"message":
