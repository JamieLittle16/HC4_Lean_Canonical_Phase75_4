  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 434: /-- The automatically selected first transverse order gives precisely the",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 435: `PreterminalSchurDepartureData` expected by the linearisation theorem. -/",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 436: noncomputable def firstSchurData",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 437:     {D complexity : ℕ}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 438:     {f : CanonicalSmithDepartureFrontier",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 439:       (K := K) D complexity}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 440:     (S : FrontierClearedRankOneSchurSeries f) :",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 441:     PreterminalSchurDepartureData (Fin 4) K where",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 442:   order := S.firstOrder",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 443:   leadingScalar := S.leadingScalar",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 444:   U := S.U",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 445:   V := S.V",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 446:   potential := S.firstPotential",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 447:   active := S.series.active",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 448:   offDiag := S.series.offDiag",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 449:   kernel := S.series.kernel",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 450:   order_pos := S.firstOrder_pos",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 451:   leadingScalar_ne_zero := S.leadingScalar_ne_zero",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 452:   active_coeff_zero := by",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 453:     rw [S.series.active_coeff_zero, S.leading_eq]",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 454:   offDiag_lower_zero := by",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 455:     intro n hn",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 456:     exact",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 457:       S.series.offDiag_coeff_eq_zero_of_lt_first",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 458:         S.hasTransverse hn",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 459:   kernel_lower_zero := by",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 460:     intro n hn",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 461:     exact",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 462:       S.series.kernel_coeff_eq_zero_of_lt_first",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 463:         S.hasTransverse hn",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 464:   kernel_coeff_order := by",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 465:     exact S.kernel_coeff S.firstOrder",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 466:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 467: /-- If the automatically selected first transverse order is preterminal,",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 468: all fields of the cleared preterminal certificate are forced. -/",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 469: noncomputable def preterminalCertificate",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 470:     {D complexity : ℕ}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 471:     {f : CanonicalSmithDepartureFrontier",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 472:       (K := K) D complexity}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 473:     (S : FrontierClearedRankOneSchurSeries f)",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 474:     (hpre : S.firstOrder < f.defect) :",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 475:     FrontierClearedPreterminalSchurCertificate f where",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 476:   schur := S.firstSchurData",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 477:   fullDetSeries := S.fullDetSeries",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 478:   clearedFactor := S.clearedFactor",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 479:   order_lt_defect := hpre",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 480:   potential_eq_layer := rfl",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 481:   fullDet_coeff := S.fullDet_coeff",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 482:   schurFactor := by",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 483:     simpa [PreterminalSchurDepartureData.determinant,",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 484:       RankOneSchurSeries.determinant, firstSchurData] using",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 485:       S.schurFactor",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 486:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 487: /-- **Automatic preterminal exhaustion from the genuine Schur series.**",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 488: No manual choice of departure order and no lower-layer bookkeeping remain. -/",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 489: theorem preterminal_canonicalStrictRepair_or_affineSeparated",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 490:     {D complexity : ℕ}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 491:     {f : CanonicalSmithDepartureFrontier",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 492:       (K := K) D complexity}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 493:     (S : FrontierClearedRankOneSchurSeries f)",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 494:     (hpre : S.firstOrder < f.defect) :",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 495:     (RepairProgress",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 496:         (rankOneRepairState complexity)",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 497:         (rankTwoRepairState complexity) ∧",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 498:       binaryDirectionalHessianDet S.U S.V S.firstPotential =",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 499:         -(directionalMixedDerivative S.U S.V S.firstPotential)^2 ∧",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 500:       binaryDirectionalHessianDet S.U S.V S.firstPotential ≠ 0 ∧",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 501:       (rankTwoRepairState complexity).measure <",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 502:         (rankOneRepairState complexity).measure) ∨",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 503:       IsPreterminalAffineSeparatedChannel S.U S.V S.firstPotential := by",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 504:   exact",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 505:     (S.preterminalCertificate hpre).canonicalStrictRepair_or_affineSeparated",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 506:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 507: end FrontierClearedRankOneSchurSeries",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 508:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 509: /-! -----------------------------------------------------------------------",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 510:   Exact closing-clock Schur frontier",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 511: ------------------------------------------------------------------------ -/",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 512:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 513: /-- A stronger and more economical rank-one Schur frontier.",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 514:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 515: The exact Hessian defect has already identified the full determinant with",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 516: `X^defect`.  Hence the genuinely useful cleared identity is simply",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 517:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 518:     det(Schur) = clearedFactor * X^defect.",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 519:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 520: A nonzero constant coefficient of `clearedFactor` is the algebraic",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 521: expression of the fact that the already-active block remains invertible at",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 522: the special fibre.  From these two facts the first positive transverse",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 523: Schur order exists automatically and can occur no later than `defect`.",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 524: Thus the local rank-one branch has only the intended alternatives:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 525: preterminal departure or determinant-closing departure. -/",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 526: structure FrontierExactRankOneSchurSeries",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 527:     {D complexity : ℕ}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 528:     (f : CanonicalSmithDepartureFrontier",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 529:       (K := K) D complexity) where",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 530:   series : RankOneSchurSeries (MvPolynomial (Fin 4) K)",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 531:   leadingScalar : K",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 532:   leadingScalar_ne_zero : leadingScalar ≠ 0",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 533:   U : Fin 4",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 534:   V : Fin 4",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 535:   leading_eq : series.leading = MvPolynomial.C leadingScalar",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 536:   clearedFactor : Polynomial (MvPolynomial (Fin 4) K)",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 537:   clearedFactor_coeff_zero_ne_zero :",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 538:     clearedFactor.coeff 0 ≠ 0",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 539:   kernel_coeff :",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 540:     ∀ n : ℕ,",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 541:       series.kernel.coeff n =",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 542:         directionalSecondDerivative V",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 543:           (familyParameterLayer f.lossless.family n)",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 544:   schurFactor :",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 545:     series.determinant =",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 546:       clearedFactor * Polynomial.X ^ f.defect",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 547:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 548: namespace FrontierExactRankOneSchurSeries",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 549:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 550: /-- The exact cleared identity forces the existence of a later transverse",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 551: Schur layer; no separate existence hypothesis is needed. -/",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 552: theorem hasTransverse",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 553:     {D complexity : ℕ}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 554:     {f : CanonicalSmithDepartureFrontier",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 555:       (K := K) D complexity}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 556:     (S : FrontierExactRankOneSchurSeries f) :",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 557:     S.series.HasPositiveTransverseLayer := by",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 558:   exact",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 559:     S.series.hasPositiveTransverseLayer_of_determinant_eq_factor_mul_X_pow",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 560:       S.clearedFactor f.defect S.schurFactor",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 561:       S.clearedFactor_coeff_zero_ne_zero",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 562:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 563: /-- Canonical first transverse order of the exact Schur frontier. -/",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 564: noncomputable def firstOrder",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 565:     {D complexity : ℕ}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 566:     {f : CanonicalSmithDepartureFrontier",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 567:       (K := K) D complexity}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 568:     (S : FrontierExactRankOneSchurSeries f) : ℕ :=",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 569:   S.series.firstPositiveTransverseOrder S.hasTransverse",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 570:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 571: /-- The first transverse order is strictly positive. -/",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 572: theorem firstOrder_pos",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 573:     {D complexity : ℕ}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 574:     {f : CanonicalSmithDepartureFrontier",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 575:       (K := K) D complexity}",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 576:     (S : FrontierExactRankOneSchurSeries f) :",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 577:     0 < S.firstOrder := by",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 578:   exact S.series.firstPositiveTransverseOrder_pos S.hasTransverse",
   "level": "info"},
  {"message": "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 579:",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 580: /-- **No post-closing first departure.**",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 581: The nonzero constant clearing factor forces the first transverse Schur",
   "level": "info"},
