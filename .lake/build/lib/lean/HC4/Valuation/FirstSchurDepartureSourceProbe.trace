  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 153:         (firstPositiveActualParameterOrder f.lossless.family h)",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 154:         b V) :",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 155:     (RepairProgress",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 156:         (rankOneRepairState complexity)",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 157:         (rankTwoRepairState complexity) ∧",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 158:       binaryDirectionalHessianDet U V",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 159:           (familyParameterLayer f.lossless.family",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 160:             (firstPositiveActualParameterOrder f.lossless.family h)) =",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 161:         -(directionalMixedDerivative U V",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 162:           (familyParameterLayer f.lossless.family",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 163:             (firstPositiveActualParameterOrder f.lossless.family h)))^2 ∧",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 164:       binaryDirectionalHessianDet U V",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 165:           (familyParameterLayer f.lossless.family",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 166:             (firstPositiveActualParameterOrder f.lossless.family h)) ≠ 0 ∧",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 167:       (rankTwoRepairState complexity).measure <",
   "level": "info"},
  {"message":
   "HC4/Valuation/FirstSchurDepartureSourceProbe.lean:17:0: 168:         (rankOneRepairState complexity).measure) ∨",
   "level": "info"},
